# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI — required for /portfolio demos (RAG KB chat + lead automation).
# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your_openai_key_here

# Salt for hashing client IPs in tool_runs (rate-limit ledger).
# Rotate to invalidate all existing rate-limit buckets at once.
RATE_LIMIT_SALT=change_me_to_a_long_random_string

# Anthropic — required for /demos lead-agent classification (Claude Haiku 4.5).
# Also used by site-audit diagnose + newsletter generator.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Resend — transactional email for assessments + demo lead notifications.
RESEND_API_KEY=re_your_resend_key_here

# Discord webhook — receives /demos lead notifications (free, no Slack tier).
# Server settings → Integrations → Webhooks → New Webhook → copy URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Optional outbound call bridge for /demos Call Me.
# Server-side only. Never prefix these with NEXT_PUBLIC_.
DEMO_CALL_ORIGINATE_URL=https://your-call-bridge.example.com/originate
DEMO_CALL_ORIGINATE_TOKEN=replace_with_server_side_webhook_token

# Optional override — defaults to chad@stackconsultingai.com.
LEAD_NOTIFY_EMAIL=chad@stackconsultingai.com

# Beehiiv — newsletter subscription. Without these the form falls back to a
# visible "Finish subscribing" link pointing at NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_URL.
# API key: https://app.beehiiv.com/settings/api
# Publication ID: Settings → Integrations → API.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
# Optional — override the default subscribe page (defaults to
# https://stackconsultingai.beehiiv.com/subscribe). Set when the publication
# is renamed or moved to a custom domain.
NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_URL=